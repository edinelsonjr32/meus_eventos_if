# ============================================================
# Meus Eventos IF — configuração de PRODUÇÃO (HostGator / cPanel)
# Copie para ".env" na pasta do aplicativo (fora do public_html) e preencha.
# NUNCA publique este arquivo preenchido nem o coloque em pasta pública.
# ============================================================

APP_NAME="Meus Eventos IF"
APP_ENV=production
# Gere com: php artisan key:generate --force   (não troque depois de haver dados)
APP_KEY=
APP_DEBUG=false
APP_URL=https://eventos.seudominio.com.br
APP_TIMEZONE=America/Belem
# Caminho ABSOLUTO da pasta pública (onde está o index.php). Ex.: /home/CONTA/public_html
PUBLIC_PATH=
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Banco MySQL criado no cPanel (nome e usuário vêm com o prefixo da conta) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CONTA_eventos
DB_USERNAME=CONTA_eventos
DB_PASSWORD=

# --- Sessão, cache e fila no banco (não exigem Redis nem processo permanente) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=database

# Fila: o próprio agendador (um único cron por minuto) processa os jobs pendentes
QUEUE_CONNECTION=database
QUEUE_VIA_CRON=true

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- E-mail: caixa criada no cPanel (Contas de e-mail). Porta 465 usa SSL (smtps). ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.seudominio.com.br
MAIL_PORT=465
MAIL_USERNAME=nao-responda@seudominio.com.br
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --- Ghostscript (PDF compilado dos Anais). Confirme com: php artisan sistema:verificar ---
GS_BINARY=gs

# Privacidade (LGPD) - exibido em /privacidade
PRIVACIDADE_CONTROLADOR="Instituto Federal do Pará - Campus Óbidos"
PRIVACIDADE_CONTATO=privacidade@seudominio.com.br
PRIVACIDADE_ENCARREGADO=
PRIVACIDADE_DIAS_RASCUNHO=180
PRIVACIDADE_DIAS_BACKUP=14
